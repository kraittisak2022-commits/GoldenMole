# Shared ignores for monorepo Vercel projects (Git + CLI uploads).
# Do NOT list apps/photo or apps/flowaccount here — those have their own
# Vercel projects with Root Directory under apps/*, and ignoring them
# strips their source from the build (vite exit 127 / ENOENT).

mobile-flutter/
mobile-stone-sand/
ios-swiftui/
.cursor/
.claude/
.agent/
awesome-claude-code-subagents/
testsprite_tests/
test-results/
playwright-report/
blob-report/
evals/results/
**/node_modules/
**/dist/
**/.dart_tool/
**/build/
**/.gradle/
**/.cxx/
**/Pods/
**/.venv/
**/__pycache__/
**/*.tsbuildinfo
.env
.env.*

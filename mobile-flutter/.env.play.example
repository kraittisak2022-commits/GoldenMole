# Copy to .env.play and fill in (never commit .env.play).

# Google Play Developer API — service account JSON from Play Console → Setup → API access
PLAY_STORE_JSON_KEY_PATH=C:/path/to/goldenmole-play-api.json

# Closed testing track slug (Play Console → Testing → Closed testing → track name)
# Common values: alpha (default closed), internal, or your custom track slug
PLAY_STORE_TRACK=alpha

# Optional default release name (overridden by -ReleaseName in release-android-closed.ps1)
# PLAY_RELEASE_NAME=1.0.3 — คำอธิบายสั้นๆ

# Supabase soft-update fields (service role — keep secret)
SUPABASE_URL=https://cocvespahjymyrvmqzcs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

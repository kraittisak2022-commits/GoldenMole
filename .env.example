# Supabase Configuration (required for database)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: comma-separated LINE user IDs for advance payout alerts (see docs/LINE.md)
VITE_LINE_ADVANCE_NOTIFY_USER_IDS=

# Optional: same value as Supabase secret NOTIFY_ADVANCE_INVOKER_SECRET — call notify-advance-line without Anonymous Auth
VITE_NOTIFY_ADVANCE_INVOKER_SECRET=
